# Copy to .env.local for local dev. All values are public (NEXT_PUBLIC_*) and baked into the static build.

# Canonical site URL used in metadata, sitemap and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://zuggi.example

# Supabase (Join Free / waitlist). Leave empty to run in "preview mode" (form shows success, nothing saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the games CDN (Cloudflare R2 public bucket or custom domain, e.g. https://games.zuggi.example)
# A game with gameUrl "neon-drift/index.html" loads from ${NEXT_PUBLIC_GAMES_CDN}/neon-drift/index.html
NEXT_PUBLIC_GAMES_CDN=

# Only for the GitHub Pages preview build (serves the site under /zuggi-site)
# GITHUB_PAGES=true
